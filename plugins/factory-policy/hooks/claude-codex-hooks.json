{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/policy-gate.sh\"",
            "timeout": 10,
            "statusMessage": "factory-policy v1 warn-default PreToolUse"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/stop-verify.sh\"",
            "timeout": 10,
            "statusMessage": "factory-policy v1 warn-default Stop"
          }
        ]
      }
    ]
  }
}
